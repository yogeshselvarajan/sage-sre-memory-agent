# Optional: AWS Bedrock Guardrail configuration for SAGE
#
# Copy this file to .env.guardrail and fill in your values.
# .env.guardrail is gitignored - never commit real IDs.
#
# Create a guardrail in the AWS Console:
#   Bedrock > Guardrails > Create guardrail
#   Recommended: enable PII blocking and deny-list for destructive shell commands
#
# SAGE validates the guardrail ID against the active AWS account at startup.
# If the ID is not found (e.g. wrong account), it runs without the guardrail
# and prints a warning - it does not crash.

SAGE_GUARDRAIL_ID=your-guardrail-id-here
SAGE_GUARDRAIL_VERSION=1
